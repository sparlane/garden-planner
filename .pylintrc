[MASTER]
load-plugins=pylint_django

django-settings-module=gp.settings
ignore=migrations 

max-line-length=240

[MESSAGES CONTROL]
# The costing subledger reads inventory, applications, plantings, and
# seedtrays, and each of those has to call back into it when it posts a fact
# whose cost has to move. That callback is a deliberate function-scoped import,
# the same technique seedtrays/generations.py and plantings/lifecycle.py
# already use to keep a domain dependency one-way at module load. Pylint counts
# it as a cycle regardless, so the check is off rather than every participating
# module carrying a local disable for a pattern the codebase has settled on.
disable=cyclic-import
